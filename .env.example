# Copy to .env and adjust. All optional — defaults in backend/app/core/config.py.
# DATA_DIR=/app/data
# SCHEMA_DIR=/app/schema
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
# PRIVATE_EXPLORATIONS_ENABLED=1
# EXPLORATION_STATE_DIR=/absolute/private/path/history-kb-explorations

# 默认 none：只跑确定性结构与缺口记录，绝不假装调用过模型。
# 要调用模型，必须显式切换 provider，并同时配置 endpoint、key 与三个能力路由。
# EXPLORATION_MODEL_PROVIDER=openai_compatible
# EXPLORATION_MODEL_BASE_URL=https://your-provider.example/v1
# EXPLORATION_MODEL_API_KEY=...
# EXPLORATION_EXTRACT_MODEL=...
# EXPLORATION_SYNTHESIS_MODEL=...
# EXPLORATION_JUDGE_MODEL=...
# EXPLORATION_MODEL_CONNECT_TIMEOUT_SECONDS=5
# EXPLORATION_MODEL_TOTAL_TIMEOUT_SECONDS=45
# EXPLORATION_WORKER_POLL_SECONDS=1
