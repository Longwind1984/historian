              "$ref": "#/$defs/checkState"
            },
            "external_rights_recorded": {
              "$ref": "#/$defs/checkState"
            },
            "human_approved": {
              "$ref": "#/$defs/checkState"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "derivative_ready"
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "properties": {
                  "no_raw_source": {
                    "const": "pass"
                  },
                  "no_private_locator": {
                    "const": "pass"
                  },
                  "no_credentials": {
                    "const": "pass"
                  },
                  "no_reconstructive_summary": {
                    "const": "pass"
                  },
                  "external_rights_recorded": {
                    "const": "pass"
                  },
                  "human_approved": {
                    "const": "pass"
                  }
                }
              }
            }
          }
        }
