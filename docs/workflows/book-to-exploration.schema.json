            "no_private_locator",
            "no_credentials",
            "no_reconstructive_summary",
            "external_rights_recorded",
            "human_approved"
          ],
          "properties": {
            "no_raw_source": {
              "$ref": "#/$defs/checkState"
            },
            "no_private_locator": {
              "$ref": "#/$defs/checkState"
            },
            "no_credentials": {
              "$ref": "#/$defs/checkState"
            },
